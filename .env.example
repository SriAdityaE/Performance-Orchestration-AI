# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# Absolute path to the shared folder accessible by both the local machine and the VM.
PERF_SHARED_ROOT=L:\MCP\Performance_TestExecution-Reporting

# Absolute path to the JMeter installation on the VM (must contain bin\jmeter.bat).
JMETER_HOME=L:\apache-jmeter-5.5\apache-jmeter-5.5

# Notification channel: slack | terminal | teams | both
NOTIFICATION_CHANNEL=slack

# Required when NOTIFICATION_CHANNEL is 'slack' or 'both'.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Optional ──────────────────────────────────────────────────────────────────
# Root folder for external test log backups (round-based naming).
# Defaults to L:\testlogs if the path is writable; omit to disable external backup.
TEST_LOG_ROOT=L:\testlogs

# Name that appears in the report closing signature.
# Defaults to "Performance Team" if not set.
REPORT_SIGNER_NAME=Your Name

# Required only when NOTIFICATION_CHANNEL is 'teams' or 'both'.
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL
